# PostgreSQL on the same machine. Create the role/database once (pgAdmin or psql, as postgres):
#   CREATE ROLE kardex LOGIN PASSWORD '<password>';
#   CREATE DATABASE kardex OWNER kardex;
DATABASE_URL="postgresql+asyncpg://kardex:<password>@localhost:5432/kardex"
APP_ENV="production"
PORT=8000
# Log every SQL statement
SQL_ECHO=false
