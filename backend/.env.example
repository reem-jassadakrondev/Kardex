# Supabase: Project Settings -> Database -> Connection string. Paste as-is; the backend
# translates pgbouncer/sslmode for asyncpg. Omit both URLs to use local SQLite (backend/kardex.db).
# Runtime: transaction pooler (port 6543)
DATABASE_URL="postgresql+asyncpg://postgres.bycscpbaoqnoskxlsumn:[YOUR_PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Migrations (alembic): session pooler (port 5432)
DIRECT_URL="postgresql+asyncpg://postgres.bycscpbaoqnoskxlsumn:[YOUR_PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require"
APP_ENV="development"
PORT=8000
# Log every SQL statement
SQL_ECHO=false
